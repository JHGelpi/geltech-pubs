---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  projects: CollectionEntry<'projects'>[];
  heading?: 'h2' | 'h3';
}
const { projects, heading: H = 'h2' } = Astro.props;
const label = { live: 'Live', beta: 'Beta', archived: 'Archived' } as const;
---

{projects.length === 0 ? (
  <div class="card empty-state"><p class="muted">Projects coming soon.</p></div>
) : (
  <div class="card-grid">
    {projects.map((p) => (
      <article class="card project-card">
        <H class="project-title">{p.data.name} <span class={`badge badge-${p.data.status}`}>{label[p.data.status]}</span></H>
        <p>{p.data.summary}</p>
        <p class="actions">
          <a class="btn btn-secondary" href={p.data.url} aria-label={`Open ${p.data.name}`}>Open ↗</a>
          {p.data.repo && <a href={p.data.repo}>Source</a>}
        </p>
      </article>
    ))}
  </div>
)}
