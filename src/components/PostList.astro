---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  posts: CollectionEntry<'blog'>[];
  empty?: string;
}
const { posts, empty = 'No posts yet.' } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

{posts.length === 0 ? (
  <p class="muted">{empty}</p>
) : (
  <ul class="post-list">
    {posts.map((p) => (
      <li>
        <time datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time>
        <a href={`/blog/${p.id}/`}>{p.data.title}</a>
      </li>
    ))}
  </ul>
)}
