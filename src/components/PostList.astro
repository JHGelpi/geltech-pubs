---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';

export interface Props {
  posts: CollectionEntry<'blog'>[];
  headingLevel?: 'h2' | 'h3';
}
const { posts, headingLevel = 'h3' } = Astro.props;
---

{posts.length === 0 ? (
  <div class="card empty-state">
    <p class="empty-title">First post coming soon</p>
    <p class="muted">Follow the <a href="/rss.xml">RSS feed</a> to hear when it's up.</p>
  </div>
) : (
  <div class="card-grid">
    {posts.map((post) => <PostCard post={post} headingLevel={headingLevel} />)}
  </div>
)}
