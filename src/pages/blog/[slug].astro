---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../site.config';
import { getPublishedPosts } from '../../lib/content';
import { readingMinutes, slugify, tocHeadings } from '../../lib/posts';
import { blogPostingJsonLd } from '../../lib/person';

export async function getStaticPaths() {
  const posts = await getPublishedPosts(); // newest first
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const toc = tocHeadings(headings);
const { title, description, pubDate, updatedDate, tags, heroImage, canonicalUrl } = post.data;
const url = new URL(`/blog/${post.id}/`, site.url).href;
// A hero image wins; otherwise the generated card from src/pages/og/blog/[slug].png.ts.
const image = heroImage ?? `/og/blog/${post.id}.png`;
const jsonLd = blogPostingJsonLd({ ...post.data, image, url });
const enc = encodeURIComponent;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title={title} description={description} type="article" canonical={canonicalUrl} image={image} jsonLd={jsonLd}>
  <article class="card post">
    <header class="post-header">
      {tags.length > 0 && <ul class="chips" aria-label="Tags">{tags.map((t) => <li><a class="chip" href={`/blog/tags/${slugify(t)}/`}>{t}</a></li>)}</ul>}
      <h1>{title}</h1>
      <p class="muted">
        <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        {updatedDate && <> · Updated <time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time></>}
        {' · '}{readingMinutes(post.body ?? '')} min read
      </p>
    </header>
    {toc.length > 0 && (
      <nav class="toc" aria-labelledby="toc-title">
        <p id="toc-title" class="toc-title">On this page</p>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    )}
    <div class="prose">
      <Content />
    </div>
    <p class="share actions">
      <span class="muted">Share:</span>
      <a class="btn btn-secondary pill-btn" href={`https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`} rel="noopener">Share on LinkedIn</a>
      <a class="btn btn-secondary pill-btn" href={`https://x.com/intent/post?url=${enc(url)}&text=${enc(title)}`} rel="noopener">Share on X</a>
    </p>
  </article>

  {(older || newer) && (
    <nav aria-label="More posts" class="post-nav">
      {older && <div class="card"><p class="muted">← Older</p><a class="stretched" href={`/blog/${older.id}/`}>{older.data.title}</a></div>}
      {newer && <div class="card newer"><p class="muted">Newer →</p><a class="stretched" href={`/blog/${newer.id}/`}>{newer.data.title}</a></div>}
    </nav>
  )}
</BaseLayout>
