---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import ProjectList from '../components/ProjectList.astro';
import headshot from '../assets/headshot.png';
import { site } from '../site.config';
import { getPublishedPages, getPublishedPosts, getProjects } from '../lib/content';
import { personJsonLd } from '../lib/person';

const posts = (await getPublishedPosts()).slice(0, 4);
const projects = (await getProjects()).slice(0, 3);
// The /now/ page as a tile; absent while now.md is a draft.
const now = (await getPublishedPages()).find((p) => p.id === 'now');
const NowContent = now && (await render(now)).Content;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title={site.name} description={site.tagline} jsonLd={personJsonLd()}>
  <section class="card hero">
    <Image src={headshot} alt={site.name} width={96} height={96} densities={[1, 2]} class="headshot" loading="eager" />
    <div class="hero-text">
      <h1>{site.name}</h1>
      <p class="muted hero-tagline">{site.tagline}</p>
      <p>{site.bio}</p>
      <p class="actions">
        <a class="btn btn-primary" href="/blog/">Read the blog</a>
        <a class="btn btn-secondary" href="/about/">About me</a>
      </p>
    </div>
  </section>

  {now && NowContent && (
    <>
      <h2 class="section-label">Now</h2>
      <div class="card now-card">
        <div class="prose"><NowContent /></div>
        <p class="muted now-meta">
          {now.data.updated && <>Updated <time datetime={now.data.updated.toISOString()}>{fmt(now.data.updated)}</time> · </>}
          <a href="/now/">Now page →</a>
        </p>
      </div>
    </>
  )}

  <h2 class="section-label">Latest writing</h2>
  <PostList posts={posts} headingLevel="h3" />
  {posts.length > 0 && <p class="more"><a href="/blog/">All posts →</a></p>}

  <h2 class="section-label">Projects</h2>
  <ProjectList projects={projects} heading="h3" />
</BaseLayout>
