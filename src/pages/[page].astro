---
// Standalone pages from src/content/pages (e.g. /now/). Drafts get no route in production.
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
import { getPublishedPages } from '../lib/content';

export async function getStaticPaths() {
  return (await getPublishedPages()).map((page) => ({ params: { page: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const { title, description, updated } = page.data;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title={title} description={description ?? `${title} · ${site.name}`}>
  <article class="card post">
    <header class="post-header">
      <h1>{title}</h1>
      {updated && <p class="muted">Updated <time datetime={updated.toISOString()}>{fmt(updated)}</time></p>}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
