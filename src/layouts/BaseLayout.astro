---
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ThemeScript from '../components/ThemeScript.astro';
import { site } from '../site.config';
import { getPublishedPages } from '../lib/content';

export type Props = HeadProps;
const host = new URL(site.url).host;
const footerPages = await getPublishedPages();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body>
    <!-- First in <body>, not in <head>: Astro puts the stylesheet last in <head>, and a script above it
         lets Firefox paint before the CSS arrives (flash of plain text). Here it waits for the CSS
         and still runs before any content, so there's no theme flash either. -->
    <ThemeScript />
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href="/"><span class="logo" aria-hidden="true"></span>{host}</a>
        <Nav />
        <ThemeToggle />
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer container">
      <p>© {new Date().getFullYear()} {site.name} · {footerPages.map((p) => <><a href={`/${p.id}/`}>{p.data.title}</a> · </>)}<a href="/rss.xml">RSS</a></p>
    </footer>
  </body>
</html>
